#!/usr/bin/env bash
# Installs Nginx and adds a custom X-Served-By HTTP header with the hostname
# shellcheck disable=SC2154,SC2016

apt-get update -y
apt-get install -y nginx

echo "Holberton School for the win!" > /var/www/html/index.html

# Add the header right after the "server_name _;" line (only once)
if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
    sed -i '/server_name _;/a add_header X-Served-By $hostname always;' /etc/nginx/sites-available/default
fi

# Restart Nginx without systemctl
service nginx restart || { pkill nginx; nginx; }
