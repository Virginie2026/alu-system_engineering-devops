#!/usr/bin/env bash
# Installs ufw and blocks all incoming traffic except TCP ports 22, 80 and 443

sudo apt-get update -y
sudo apt-get install -y ufw

# Default policies: deny everything incoming, allow everything outgoing
sudo ufw default deny incoming
sudo ufw default allow outgoing

# Allow SSH first so the current session is not cut off
sudo ufw allow 22/tcp
# Allow HTTP and HTTPS
sudo ufw allow 80/tcp
sudo ufw allow 443/tcp

# Enable the firewall without the interactive confirmation
sudo ufw --force enable
sudo ufw status verbose
