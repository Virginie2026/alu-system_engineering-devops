#!/usr/bin/env bash
# Configures Nginx to run as the nginx user and listen on port 8080
pkill 'apache2|nginx'
sed -i --follow-symlinks -e 's/^#\?user .*/user nginx;/' -e 's/\b80\b/8080/g' /etc/nginx/nginx.conf /etc/nginx/sites-enabled/default
chmod 644 /etc/nginx/nginx.conf
rm -f /run/nginx.pid
su -s /bin/bash -c 'service nginx start' nginx
