#!/usr/bin/env bash
# Installs and configures HAproxy with a roundrobin load balancing algorithm
apt-get update -y
apt-get install -y haproxy
sudo sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
cat << 'EOF' > /etc/haproxy/haproxy.cfg
global
	log /dev/log	local0
	log /dev/log	local1 notice
	chroot /var/lib/haproxy
	user haproxy
	group haproxy
	daemon

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
        timeout connect 5000ms
        timeout client  50000ms
        timeout server  50000ms

frontend haproxy_balancer_front
	bind *:80
	default_backend haproxy_balancer_back

backend haproxy_balancer_back
	balance roundrobin
	server web-01 web-01:80 check
	server web-02 web-02:80 check
EOF
service haproxy restart

